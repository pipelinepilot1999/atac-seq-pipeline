''
library(DESeq2)
counts <- read.delim(results/peaks/consensus_counts_header.tsv"")
library(DESeq2)
# Read count matrix
counts <- read.delim("results/peaks/consensus_counts_header.tsv")
# Check it loaded correctly
dim(counts)
head(counts)
peak_info <- counts[, 1:3]
count_matrix <- as.matrix(counts[, 4:7])
dim(count_matrix)
head(count_matrix)
col_data <- data.frame(
sample = c("MCF7_rep1", "MCF7_rep2", "Normal_donor_A", "Normal_donor_B"),
condition = c("cancer", "cancer", "normal", "normal"),
row.names = c("MCF7_rep1", "MCF7_rep2", "Normal_donor_A", "Normal_donor_B")
)
col_data
dds <- DESeqDataSetFromMatrix(
countData = count_matrix,
colData = col_data,
design = ~ condition
)
dds
dds <- DESeq(dds)
dds
# Extract results comparing cancer vs normal
# positive log2FoldChange = more open in cancer
# negative log2FoldChange = more open in normal
res <- results(dds, contrast = c("condition", "cancer", "normal"))
# Summary shows how many peaks are significant
summary(res)
# Use stricter threshold
res05 <- results(dds, contrast = c("condition", "cancer", "normal"), alpha = 0.05)
summary(res05)
# Sort by significance
res_ordered <- res[order(res$padj), ]
# Look at top 10 most significant peaks
head(as.data.frame(res_ordered), 10)
# A volcano plot shows:
#   x-axis: log2FoldChange (how MUCH a peak changed)
#   y-axis: -log10(padj) (how SIGNIFICANT the change is)
#
#   Dots to the RIGHT = more open in cancer
#   Dots to the LEFT  = more open in normal
#   Dots HIGHER UP    = more statistically significant
#
#   Significant + large change = top right or top left corners
#   Those are the interesting peaks
# First add the peak coordinates back to results
res_df <- as.data.frame(res)
res_df$chr   <- peak_info$chr
res_df$start <- peak_info$start
res_df$end   <- peak_info$end
# Color code: red = significant, grey = not
res_df$color <- ifelse(
res_df$padj < 0.05 & abs(res_df$log2FoldChange) > 1,
ifelse(res_df$log2FoldChange > 0, "red", "blue"),
"grey"
)
# red  = significantly more open in cancer
# blue = significantly more open in normal
# grey = not significant or small change
# Make the plot
plot(
res_df$log2FoldChange,
-log10(res_df$padj),
col = res_df$color,
pch = 20,
cex = 0.5,
exit()
# A volcano plot shows:
#   x-axis: log2FoldChange (how MUCH a peak changed)
#   y-axis: -log10(padj) (how SIGNIFICANT the change is)
#
#   Dots to the RIGHT = more open in cancer
#   Dots to the LEFT  = more open in normal
#   Dots HIGHER UP    = more statistically significant
#
#   Significant + large change = top right or top left corners
#   Those are the interesting peaks
# First add the peak coordinates back to results
res_df <- as.data.frame(res)
res_df$chr   <- peak_info$chr
res_df$start <- peak_info$start
res_df$end   <- peak_info$end
# Color code: red = significant, grey = not
res_df$color <- ifelse(
res_df$padj < 0.05 & abs(res_df$log2FoldChange) > 1,
ifelse(res_df$log2FoldChange > 0, "red", "blue"),
"grey"
)
# red  = significantly more open in cancer
# blue = significantly more open in normal
# grey = not significant or small change
# Make the plot
plot(
res_df$log2FoldChange,
-log10(res_df$padj),
col = res_df$color,
pch = 20,
cex = 0.5,
xlab = "log2 Fold Change (Cancer vs Normal)",
ylab = "-log10(adjusted p-value)",
main = "Differential Chromatin Accessibility\nMCF7 vs Normal Breast"
)
# Add threshold lines
abline(h = -log10(0.05), lty = 2, col = "black")
abline(v = c(-1, 1), lty = 2, col = "black")
# Add legend
legend("topright",
legend = c("More open in Cancer", "More open in Normal", "Not significant"),
col = c("red", "blue", "grey"),
pch = 20
)
# Save full results with coordinates
write.csv(res_df, "results/deseq2_results.csv", row.names = FALSE)
# Save just the significant peaks
sig_peaks <- res_df[!is.na(res_df$padj) & res_df$padj < 0.05 & abs(res_df$log2FoldChange) > 1, ]
write.csv(sig_peaks, "results/significant_peaks.csv", row.names = FALSE)
# How many significant?
nrow(sig_peaks)
# Save volcano plot
pdf("results/volcano_plot.pdf", width = 8, height = 6)
plot(
res_df$log2FoldChange,
-log10(res_df$padj),
col = res_df$color,
pch = 20,
cex = 0.5,
xlab = "log2 Fold Change (Cancer vs Normal)",
ylab = "-log10(adjusted p-value)",
main = "Differential Chromatin Accessibility\nMCF7 vs Normal Breast"
)
abline(h = -log10(0.05), lty = 2, col = "black")
abline(v = c(-1, 1), lty = 2, col = "black")
legend("topright",
legend = c("More open in Cancer", "More open in Normal", "Not significant"),
col = c("red", "blue", "grey"),
pch = 20
)
dev.off()
# Save results
write.csv(res_df, "results/deseq2_results.csv", row.names = FALSE)
# Save significant peaks only
sig_peaks <- res_df[!is.na(res_df$padj) & res_df$padj < 0.05 & abs(res_df$log2FoldChange) > 1, ]
write.csv(sig_peaks, "results/significant_peaks.csv", row.names = FALSE)
nrow(sig_peaks)
BiocManager::install(c("ChIPseeker", "TxDb.Hsapiens.UCSC.hg38.knownGene", "org.Hs.eg.db", "clusterProfiler"))
library(ChIPseeker)
library(TxDb.Hsapiens.UCSC.hg38.knownGene)
library(org.Hs.eg.db)
library(clusterProfiler)
# Step 1 — Convert significant peaks to a GRanges object
# GRanges is R's way of storing genomic coordinates
# ChIPseeker needs this format
library(GenomicRanges)
sig_gr <- GRanges(
seqnames = sig_peaks$chr,
ranges = IRanges(start = sig_peaks$start, end = sig_peaks$end)
)
# seqnames = chromosome
# IRanges  = start and end position
# This converts your peak table into a genomic coordinate object
# Add the fold change info so we know direction
sig_gr$log2FoldChange <- sig_peaks$log2FoldChange
sig_gr$padj <- sig_peaks$padj
# Check
sig_gr
# Step 2 — Load the gene database
# This tells ChIPseeker where every human gene is located
txdb <- TxDb.Hsapiens.UCSC.hg38.knownGene
# Step 3 — Annotate peaks
# For each peak, ChIPseeker asks:
#   "Is this peak at a promoter? intron? exon?
#    intergenic? How far from the nearest gene?"
#
# tssRegion = how far from a gene's start site
#   counts as "promoter"
#   -3000 to +3000 means within 3kb of the TSS
peakAnno <- annotatePeak(
sig_gr,
TxDb = txdb,
annoDb = "org.Hs.eg.db",
tssRegion = c(-3000, 3000)
)
# See the summary
peakAnno
# Plot where peaks are located (pie chart)
plotAnnoPie(peakAnno)
# Plot distance to TSS
plotDistToTSS(peakAnno)
plotAnnoPie(peakAnno)
plotDistToTSS(peakAnno)
# Convert annotation to a data frame
anno_df <- as.data.frame(peakAnno)
# Look at the columns we got
head(anno_df[, c("seqnames", "start", "end", "log2FoldChange", "annotation", "SYMBOL")])
# Split peaks into cancer-open and normal-open
# Positive log2FC = more open in cancer
# Negative log2FC = more open in normal
cancer_open <- anno_df[anno_df$log2FoldChange > 1, ]
normal_open <- anno_df[anno_df$log2FoldChange < -1, ]
# How many genes in each group?
cat("Cancer-open peaks:", nrow(cancer_open), "\n")
cat("Normal-open peaks:", nrow(normal_open), "\n")
cat("Unique cancer genes:", length(unique(cancer_open$SYMBOL)), "\n")
cat("Unique normal genes:", length(unique(normal_open$SYMBOL)), "\n")
# Split peaks into cancer-open and normal-open
# Positive log2FC = more open in cancer
# Negative log2FC = more open in normal
cancer_open <- anno_df[anno_df$log2FoldChange > 1, ]
normal_open <- anno_df[anno_df$log2FoldChange < -1, ]
# How many genes in each group?
cat("Cancer-open peaks:", nrow(cancer_open), "\n")
cat("Normal-open peaks:", nrow(normal_open), "\n")
cat("Unique cancer genes:", length(unique(cancer_open$SYMBOL)), "\n")
cat("Unique normal genes:", length(unique(normal_open$SYMBOL)), "\n")
# GO enrichment for cancer-open genes
# enrichGO asks: "are these genes clustered in
#   specific biological processes more than expected by chance?"
#
# ont = "BP" means Biological Process
# Other options: "MF" (molecular function), "CC" (cellular component)
cancer_go <- enrichGO(
gene = unique(cancer_open$SYMBOL),
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "BP",
pAdjustMethod = "BH",
pvalueCutoff = 0.05
)
# Top 10 enriched pathways in cancer-open regions
head(cancer_go, 10)
# GO enrichment for normal-open genes
normal_go <- enrichGO(
gene = unique(normal_open$SYMBOL),
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "BP",
pAdjustMethod = "BH",
pvalueCutoff = 0.05
)
# Top 10 pathways in normal-open regions
head(normal_go, 10)
# Save GO results
write.csv(as.data.frame(cancer_go), "results/GO_cancer_open.csv", row.names = FALSE)
write.csv(as.data.frame(normal_go), "results/GO_normal_open.csv", row.names = FALSE)
# Dotplot for cancer-open pathways
pdf("results/GO_cancer_dotplot.pdf", width = 10, height = 8)
dotplot(cancer_go, showCategory = 15, title = "GO: Regions More Open in Cancer")
dev.off()
# Dotplot for normal-open pathways
pdf("results/GO_normal_dotplot.pdf", width = 10, height = 8)
dotplot(normal_go, showCategory = 15, title = "GO: Regions More Open in Normal")
dev.off()
# Cancer-open peaks as BED for HOMER
cancer_bed <- sig_peaks[sig_peaks$log2FoldChange > 1, c("chr", "start", "end")]
write.table(cancer_bed, "results/cancer_open_peaks.bed",
sep = "\t", quote = FALSE, row.names = FALSE, col.names = FALSE)
# Normal-open peaks as BED for HOMER
normal_bed <- sig_peaks[sig_peaks$log2FoldChange < -1, c("chr", "start", "end")]
write.table(normal_bed, "results/normal_open_peaks.bed",
sep = "\t", quote = FALSE, row.names = FALSE, col.names = FALSE)
cat("Cancer BED:", nrow(cancer_bed), "peaks\n")
cat("Normal BED:", nrow(normal_bed), "peaks\n")
